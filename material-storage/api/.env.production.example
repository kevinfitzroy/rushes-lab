# material-storage-api — 生产(内网 LAN)部署 .env 模板(issue #152 / ADR-0008)
# 用法:
#   1. cp .env.production.example .env 并填所有 <> 占位值
#   2. 两个 compose 各自的插值变量(MS_PG_DATA_DIR 等)也写在 .env(docker compose
#      自动读 compose 同目录 .env):api/docker-compose.yml 读本目录 .env;
#      poc/minio/docker-compose.yml 读 poc/minio/.env(MINIO_DATA_DIR 等 MINIO_* 那组)
#   3. 机密(<...> 或见 server.md)严禁进 git;.env 已 gitignore
# 完整拓扑/备份/恢复/降级说明见 rushes-spec/material-storage/ops-manual.md「内网生产部署」章。

ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Postgres(业务元数据 + audit;与 OpenFGA 共 host 不同容器)──────
DB_URL=postgresql+asyncpg://msuser:<DB_PASSWORD>@ms-db:5432/material_storage

# ─── Redis(arq queue + session cache)──────
REDIS_URL=redis://ms-redis:6379/0

# ─── MinIO 原片(HDD)──────────────────────
# ⚠️ 内网无 https:P-10 坑 — MINIO_ENDPOINT_PUBLIC 必须等于浏览器实际访问的 host
#    (hosts 文件 / DNS 解析后的内网地址),否则 presigned URL 签名 host 不匹配
MINIO_ENDPOINT_INTERNAL=http://poc-pigsty-minio:9000
MINIO_ENDPOINT_PUBLIC=http://<LAN-HOST>
MINIO_ACCESS_KEY=<MINIO_ROOT_USER>            # 必须与 MinIO 容器 MINIO_ROOT_USER 一致(rotate before prod)
MINIO_SECRET_KEY=<MINIO_ROOT_PASSWORD>        # 同上;openssl rand -hex 16 生成,轮换见 ops-manual
MINIO_DEFAULT_BUCKET=ms-dev

# ─── 缩略图分层(ADR-0008 P1:SSD 第二个 MinIO)────────────────
# 内部端点 = SSD 缩略图容器(docker 内);公开端点与主 MinIO 同 host —
# nginx 按 bucket 名前缀 /ms-thumbs/ 路由到缩略图实例(见 poc/minio/nginx/default.conf)
MINIO_THUMBNAIL_ENDPOINT_INTERNAL=http://poc-minio-thumbs:9000
MINIO_THUMBNAIL_ENDPOINT_PUBLIC=http://<LAN-HOST>
MINIO_THUMBNAIL_BUCKET=ms-thumbs
# 降级开关:缩略图桶溢出 / 缩略图 MinIO 故障时,指回原片 bucket 并清掉上面两个
# THUMBNAIL_ENDPOINT(留空 = 回落主实例),无需数据迁移:
#   MINIO_THUMBNAIL_BUCKET=ms-dev
#   # MINIO_THUMBNAIL_ENDPOINT_INTERNAL=
#   # MINIO_THUMBNAIL_ENDPOINT_PUBLIC=

# ─── OpenFGA ──────────────────────────────
OPENFGA_API_URL=http://poc-openfga:8080
OPENFGA_STORE_ID=<STORE_ID>
# OPENFGA_MODEL_ID=...        # 可选;None = 用 store latest

# ─── session JWT(openssl rand -hex 32 生成)───
SESSION_JWT_SECRET=<openssl-rand-hex-32>
SESSION_COOKIE_SECURE=false              # 内网 http;若未来上 https 改 true
SESSION_COOKIE_SAMESITE=lax

# ─── presigned URL TTL ────────────────────
PRESIGNED_NORMAL_TTL_SECONDS=900
PRESIGNED_SENSITIVE_TTL_SECONDS=600

# ─── audit ────────────────────────────────
AUDIT_RETENTION_DAYS=365

# ─── 默认组织 ─────────────────────────────
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-0000000000a1

# ─── compose 卷布局(ADR-0008 P0:SSD /ssd 热数据、HDD /data 原片)──
# 这些不是 ms-api 的 env,是 docker compose 插值;部署时 export 到 shell 或 .env 同文件可见
MS_PG_DATA_DIR=/ssd/pg
MS_REDIS_DATA_DIR=/ssd/redis
MINIO_DATA_DIR=/data/minio-originals
MINIO_THUMBS_DATA_DIR=/ssd/minio-thumbs
# MinIO 容器 root 凭据(与 MINIO_ACCESS_KEY/MINIO_SECRET_KEY 保持一致)
MINIO_ROOT_USER=<MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<MINIO_ROOT_PASSWORD>
MINIO_THUMBS_ROOT_USER=<MINIO_ROOT_USER>
MINIO_THUMBS_ROOT_PASSWORD=<MINIO_ROOT_PASSWORD>
# 缩略图 MinIO 的 MINIO_SERVER_URL(浏览器视角;与 MINIO_ENDPOINT_PUBLIC 同 host)
MINIO_THUMBS_SERVER_URL=http://<LAN-HOST>
